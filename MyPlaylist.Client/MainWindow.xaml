<Window x:Class="MyPlaylist.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"        Title="PLAY &amp; SHARE" Width="1280" Height="760" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        SourceInitialized="Window_SourceInitialized">
    <Grid x:Name="RootGrid">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 상단 바 -->
            <Border Margin="56,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
                <Grid Height="68">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource LinkButton}" Click="Logo_Click"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Logo" AutomationProperties.Name="PLAY &amp; SHARE">
                        <!-- 로고: 여우 아이콘은 흰색 마스크(logo-mask.png)에 테마의 골드 색을 입혀 표시한다. -->
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="46" Height="46" Fill="{DynamicResource GoldBrush}" VerticalAlignment="Center">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Assets/logo-mask.png" Stretch="Uniform"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <!-- WPF에는 자간 설정이 없으므로 글자 사이에 얇은 공백(U+2009)을 넣어 넓게 벌린다. -->
                            <TextBlock Text="P&#x2009;L&#x2009;A&#x2009;Y &#x2009;&amp;&#x2009; S&#x2009;H&#x2009;A&#x2009;R&#x2009;E"
                                       FontFamily="Segoe UI" FontSize="22" FontWeight="Normal" Margin="14,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource GoldBrush}"/>
                        </StackPanel>
                    </Button>
                    <!-- 로고 오른쪽: 구분선 + 둘러보기 / 내 보관함 -->
                    <StackPanel x:Name="NavArea" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="1" Height="28" Background="{DynamicResource SubTextBrush}" Margin="28,0,18,0"/>
                        <RadioButton x:Name="BrowseNav" Content="둘러보기" GroupName="TopNav" Style="{StaticResource SmallTabRadio}"
                                     FontSize="16" Click="BrowseNav_Click" AutomationProperties.AutomationId="NavBrowse"/>
                        <RadioButton x:Name="LibraryNav" Content="내 보관함" GroupName="TopNav" Style="{StaticResource SmallTabRadio}"
                                     FontSize="16" Margin="8,0,0,0" Click="LibraryNav_Click" AutomationProperties.AutomationId="NavLibrary"/>
                    </StackPanel>
                    <Grid x:Name="SearchArea" Grid.Column="2" VerticalAlignment="Center" Margin="32,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SubTextBrush}">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="17" Padding="2,7,10,7"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </Border>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" Style="{StaticResource UnderlineBox}" KeyDown="SearchBox_KeyDown"
                                     TextChanged="SearchBox_TextChanged" MaxLength="100"
                                     AutomationProperties.AutomationId="SearchBox"/>
                            <TextBlock x:Name="SearchHint" Text="플레이리스트, 곡, 아티스트 검색" FontSize="15" IsHitTestVisible="False"
                                       Foreground="{DynamicResource SubTextBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                    <!-- 비로그인 -->
                    <StackPanel x:Name="GuestMenu" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="36,0,0,0">
                        <Button Content="로그인" Style="{StaticResource LinkButton}" Click="Login_Click"
                                AutomationProperties.AutomationId="TopLogin"/>
                        <Border Width="1" Height="28" Background="{DynamicResource SubTextBrush}" Margin="22,0"/>
                        <Button Content="회원가입" Style="{StaticResource GoldButton}" Click="Signup_Click"
                                AutomationProperties.AutomationId="TopSignup"/>
                    </StackPanel>
                    <!-- 로그인 -->
                    <StackPanel x:Name="UserMenu" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="36,0,0,0" Visibility="Collapsed">
                        <Button x:Name="UserNameButton" Style="{StaticResource LinkButton}" FontSize="17" Click="MyPage_Click"
                                AutomationProperties.AutomationId="TopUser"/>
                        <Border Width="1" Height="28" Background="{DynamicResource SubTextBrush}" Margin="22,0"/>
                        <Button Content="새 플레이리스트" Style="{StaticResource GoldButton}" Padding="16,10" Click="NewPlaylist_Click"
                                AutomationProperties.AutomationId="TopNewPlaylist"/>
                    </StackPanel>
                    <!-- 어두운 / 밝은 테마 전환 (로그인 화면에서도 표시) -->
                    <Button x:Name="ThemeButton" Grid.Column="4" Style="{StaticResource IconButton}" FontSize="18"
                            Margin="20,0,-8,0" VerticalAlignment="Center" Click="Theme_Click"
                            AutomationProperties.AutomationId="ThemeToggle"/>
                </Grid>
            </Border>
            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>
            <!-- 하단 플레이어 바: 곡을 재생할 때만 표시 -->
            <Grid x:Name="PlayerBar" Grid.Row="2" Visibility="Collapsed">
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
                    <Grid Height="76" Margin="56,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="380"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource AreaButton}" Click="BarTitle_Click" VerticalAlignment="Center"
                                ToolTip="재생 중인 플레이리스트로 이동" AutomationProperties.AutomationId="PlayerTitle">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="96" Height="54" ClipToBounds="True" Background="{DynamicResource PlaceholderBrush}">
                                    <Image x:Name="BarThumb" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="BarTitle" Style="{StaticResource BodyText}" FontSize="16"/>
                                    <TextBlock x:Name="BarSub" Style="{StaticResource SubText}" FontSize="13" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click"
                                    ToolTip="이전 곡" AutomationProperties.Name="이전 곡"/>
                            <Button x:Name="PlayButton" Style="{StaticResource IconButton}" FontSize="26" Margin="22,0"
                                    Foreground="{DynamicResource GoldBrush}" Click="Play_Click"
                                    AutomationProperties.AutomationId="PlayerToggle" AutomationProperties.Name="재생/일시정지"/>
                            <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click"
                                    ToolTip="다음 곡" AutomationProperties.Name="다음 곡"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TimeLabel" Style="{StaticResource SubText}" FontSize="13" VerticalAlignment="Center"
                                       Margin="0,0,20,0"/>
                            <Button Content="YouTube에서 보기" Style="{StaticResource LinkButton}" FontSize="14" Click="BarYouTube_Click"
                                    Margin="0,0,12,0"/>
                            <Button x:Name="VideoToggleButton" Style="{StaticResource IconButton}" Content="&#xE714;" FontSize="18"
                                    Click="VideoToggle_Click"/>
                            <Button x:Name="MuteButton" Style="{StaticResource IconButton}" FontSize="18" Click="Mute_Click"
                                    AutomationProperties.Name="음소거"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="16" Click="Close_Click"
                                    Foreground="{DynamicResource SubTextBrush}" ToolTip="재생 종료" AutomationProperties.Name="재생 종료"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- 위쪽 경계선에 겹친 진행 막대: 누른 위치로 이동 -->
                <Grid x:Name="ProgressArea" Height="10" Margin="0,-4,0,0" VerticalAlignment="Top" Background="Transparent"
                      Cursor="Hand" MouseLeftButtonDown="Progress_MouseDown" SizeChanged="ProgressArea_SizeChanged">
                    <Border x:Name="ProgressFill" Height="2" Width="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{DynamicResource GoldBrush}"/>
                </Grid>
            </Grid>
        </Grid>
        <!-- 영상: 재생 중인 플레이리스트의 상세 화면이면 썸네일 칸에, 아니면 작은 창으로 띄운다. -->
        <Border x:Name="VideoHost" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Black"
                Visibility="Collapsed" Width="356" Height="224">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 작은 창의 손잡이: 끌어서 이동, 두 번 누르면 원래 자리 -->
                <Border x:Name="VideoHandle" Height="24" Background="{DynamicResource DialogBrush}"
                        BorderThickness="1,1,1,0" BorderBrush="{DynamicResource LineBrush}" Cursor="SizeAll"
                        ToolTip="끌어서 옮기기 · 두 번 누르면 원래 자리로"
                        MouseLeftButtonDown="VideoHandle_MouseDown" MouseMove="VideoHandle_MouseMove"
                        MouseLeftButtonUp="VideoHandle_MouseUp">
                    <Grid>
                        <TextBlock Text="&#xE76F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- 영상 창만 닫는다. 음악은 계속 나오고 하단 바에서 다시 띄울 수 있다. -->
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Padding="8,0"
                                HorizontalAlignment="Right" Cursor="Hand" Click="HideVideo_Click"
                                Foreground="{DynamicResource SubTextBrush}" ToolTip="영상 창 닫기"
                                AutomationProperties.Name="영상 창 닫기"/>
                    </Grid>
                </Border>
                <wv2:WebView2CompositionControl x:Name="VideoView" Grid.Row="1" DefaultBackgroundColor="Black"/>
            </Grid>
        </Border>
        <!-- 확인 창: 뒤쪽 화면을 어둡게 가리고 가운데에 표시 -->
        <Grid x:Name="DialogLayer" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed">
            <Border x:Name="DialogBox" Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource SubTextBrush}"
                    BorderThickness="1" CornerRadius="2" Padding="36,30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
