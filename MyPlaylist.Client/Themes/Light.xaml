<!-- 밝은 테마: 흰 배경에서도 읽히도록 골드와 빨강은 진하게 쓴다. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DialogBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#0F0F0F"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#606060"/>
    <SolidColorBrush x:Key="GoldBrush" Color="#8C7442"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B3261E"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#F2F2F2"/>
    <!-- 골드 버튼 위의 글자 -->
    <SolidColorBrush x:Key="OnGoldBrush" Color="#FFFFFF"/>
    <!-- 목록 한 줄에 마우스를 올렸을 때 -->
    <SolidColorBrush x:Key="HoverBrush" Color="#F2F2F2"/>
    <!-- 확인 창 뒤를 가리는 막 -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000"/>
</ResourceDictionary>
