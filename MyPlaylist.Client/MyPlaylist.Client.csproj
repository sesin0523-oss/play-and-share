<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WebView2CompositionControl(영상 위에 확인 창이 겹치게 하는 컨트롤)이 Windows SDK를 사용하므로 버전을 지정한다. -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>MyPlaylist.Client</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\auth.jpg" />
    <Resource Include="Assets\logo-mask.png" />
    <!-- 앱 안의 YouTube 플레이어 페이지 -->
    <None Update="Web\player.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
