<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WebView2CompositionControl(영상 위에 확인 창이 겹치게 하는 컨트롤)이 Windows SDK를 사용하므로 버전을 지정한다. -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>MyPlaylist.Client</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- exe 파일과 작업 표시줄에 쓰이는 앱 아이콘 (창 제목 표시줄은 MainWindow의 Icon) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\auth.jpg" />
    <Resource Include="Assets\logo-mask.png" />
    <Resource Include="Assets\app.ico" />
    <!-- logo-mask.png, app.ico를 만든 원본 이미지 (빌드에는 쓰지 않음) -->
    <None Include="Assets\logo-source.png" />
    <!-- 앱 안의 YouTube 플레이어 페이지 -->
    <None Update="Web\player.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
