<!-- 프로필 동그라미: 아이디의 첫 글자를 골드 테두리 원 안에 표시한다. (사진 업로드 없음) -->
<UserControl x:Class="MyPlaylist.Client.Views.Avatar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False">
    <Border x:Name="Circle" Width="26" Height="26" CornerRadius="13" BorderThickness="1"
            BorderBrush="{DynamicResource GoldBrush}" Background="{DynamicResource PlaceholderBrush}">
        <TextBlock x:Name="Initial" FontSize="12" Foreground="{DynamicResource GoldBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
</UserControl>
