<UserControl x:Class="MyPlaylist.Client.Views.LoginPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,24,56,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Source="/Assets/auth.jpg" Stretch="UniformToFill"/>
        <Grid Grid.Column="1" Margin="64,0,0,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.ColumnSpan="2" Text="로그인" Style="{StaticResource TitleText}" Margin="0,0,0,30"/>
            <TextBlock Grid.Row="1" Text="아이디" Style="{StaticResource BodyText}" FontSize="17" VerticalAlignment="Center"/>
            <TextBox x:Name="UserNameBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource UnderlineBox}" MaxLength="50"
                     AutomationProperties.AutomationId="LoginUserName"/>
            <TextBlock Grid.Row="2" Text="비밀번호" Style="{StaticResource BodyText}" FontSize="17" VerticalAlignment="Center" Margin="0,22,0,0"/>
            <PasswordBox x:Name="PasswordBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource UnderlinePassword}" Margin="0,22,0,0"
                         AutomationProperties.AutomationId="LoginPassword"/>
            <TextBlock x:Name="ErrorLabel" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource ErrorText}" Margin="0,18,0,0"
                       Visibility="Collapsed" AutomationProperties.AutomationId="LoginError"/>
            <Button Grid.Row="4" Grid.ColumnSpan="2" Content="로그인" Style="{StaticResource GoldButton}" IsDefault="True"
                    Padding="0,14" Margin="0,26,0,0" Click="Login_Click" AutomationProperties.AutomationId="LoginSubmit"/>
            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <TextBlock Text="계정이 없나요?" Style="{StaticResource SubText}" FontSize="15" VerticalAlignment="Center"/>
                <Button Content="회원가입" Style="{StaticResource LinkButton}" Margin="16,0,0,0" Click="Signup_Click"
                        AutomationProperties.AutomationId="GoSignup"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
