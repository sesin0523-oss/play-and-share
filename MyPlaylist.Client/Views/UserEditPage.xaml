<UserControl x:Class="MyPlaylist.Client.Views.UserEditPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="56,18,56,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Button Content="‹  마이페이지" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="Cancel_Click"/>
        <TextBlock Grid.Row="1" Text="회원정보 수정" Style="{StaticResource TitleText}" Margin="0,8,0,20"/>
        <Grid Grid.Row="2" MaxWidth="1040">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="아이디" Style="{StaticResource BodyText}" FontSize="17" VerticalAlignment="Center"/>
            <TextBox x:Name="UserNameBox" Grid.Column="1" Style="{StaticResource UnderlineBox}" MaxLength="50"
                     TextChanged="UserNameBox_TextChanged" AutomationProperties.AutomationId="UserNameBox"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="2~50자" Style="{StaticResource SubText}" VerticalAlignment="Center"/>
                <Button Content="중복 확인" Style="{StaticResource LinkButton}" Margin="16,0,0,0" Click="CheckName_Click"
                        AutomationProperties.AutomationId="CheckName"/>
            </StackPanel>
            <TextBlock x:Name="NameResultLabel" Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource GoldBrush}" FontSize="14"
                       Margin="2,6,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="NameResult"/>
            <Border Grid.Row="2" Grid.ColumnSpan="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}"
                    Margin="0,24,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <TextBlock Text="비밀번호 변경" Style="{StaticResource BodyText}" FontSize="18"/>
                    <TextBlock Text="선택" Style="{StaticResource SubText}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="3" Text="현재 비밀번호" Style="{StaticResource BodyText}" FontSize="17" VerticalAlignment="Center"/>
            <PasswordBox x:Name="CurrentPasswordBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource UnderlinePassword}"
                         AutomationProperties.AutomationId="CurrentPassword"/>
            <TextBlock Grid.Row="4" Text="새 비밀번호" Style="{StaticResource BodyText}" FontSize="17" VerticalAlignment="Center" Margin="0,14,0,0"/>
            <PasswordBox x:Name="NewPasswordBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource UnderlinePassword}" Margin="0,14,0,0"
                         AutomationProperties.AutomationId="NewPassword"/>
            <TextBlock Grid.Row="4" Grid.Column="2" Text="8~100자" Style="{StaticResource SubText}" Margin="16,14,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ErrorLabel" Grid.Row="5" Grid.Column="1" Style="{StaticResource ErrorText}" Margin="2,12,0,0"
                       Visibility="Collapsed" AutomationProperties.AutomationId="UserEditError"/>
        </Grid>
        <Grid Grid.Row="3">
            <Button Content="회원탈퇴" Style="{StaticResource DangerLinkButton}" HorizontalAlignment="Left" Click="Withdraw_Click"
                    AutomationProperties.AutomationId="Withdraw"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" Style="{StaticResource LinkButton}" Margin="0,0,24,0" Click="Cancel_Click"/>
                <Button Content="저장" Style="{StaticResource GoldButton}" Padding="44,12" Click="Save_Click"
                        AutomationProperties.AutomationId="SaveUser"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
