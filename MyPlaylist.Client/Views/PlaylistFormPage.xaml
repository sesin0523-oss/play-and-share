<UserControl x:Class="MyPlaylist.Client.Views.PlaylistFormPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="56,18,56,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Button Content="‹  돌아가기" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="Cancel_Click"/>
        <TextBlock x:Name="TitleLabel" Grid.Row="1" Style="{StaticResource TitleText}" Margin="0,8,0,24"/>
        <Grid Grid.Row="2" MaxWidth="980" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="제목" Style="{StaticResource BodyText}" FontSize="17" VerticalAlignment="Center"/>
            <Grid Grid.Column="1">
                <TextBox x:Name="PlaylistTitleBox" Style="{StaticResource UnderlineBox}" MaxLength="100"
                         TextChanged="PlaylistTitleBox_TextChanged" AutomationProperties.AutomationId="PlaylistTitleBox"/>
                <TextBlock x:Name="TitleHint" Text="플레이리스트 제목을 입력하세요" FontSize="15" IsHitTestVisible="False"
                           Foreground="{DynamicResource SubTextBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Grid.Column="2" Text="100자 이내" Style="{StaticResource SubText}" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Text="설명" Style="{StaticResource BodyText}" FontSize="17" Margin="0,30,0,0"/>
            <TextBox x:Name="DescriptionBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource UnderlineBox}" MaxLength="500"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="120" Margin="0,26,0,0"
                     VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="DescriptionBox"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="500자 이내" Style="{StaticResource SubText}" Margin="16,30,0,0"/>
            <TextBlock Grid.Row="2" Text="공개 설정" Style="{StaticResource BodyText}" FontSize="17" VerticalAlignment="Center" Margin="0,26,0,0"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,26,0,0">
                <RadioButton x:Name="PublicRadio" Content="공개" GroupName="PublicSetting" Style="{StaticResource TabRadio}"
                             IsChecked="True" AutomationProperties.AutomationId="PublicRadio"/>
                <RadioButton x:Name="PrivateRadio" Content="비공개" GroupName="PublicSetting" Style="{StaticResource TabRadio}"
                             AutomationProperties.AutomationId="PrivateRadio"/>
            </StackPanel>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="비공개는 나만 볼 수 있어요" Style="{StaticResource SubText}" Margin="0,12,0,0"/>
            <!-- 분위기·장르 태그: 입력하면 기존 태그를 추천하고, 없으면 새로 만든다. -->
            <TextBlock Grid.Row="4" Text="태그" Style="{StaticResource BodyText}" FontSize="17" Margin="0,30,0,0"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,26,0,0">
                <!-- 고른 태그 (× 로 빼기) -->
                <WrapPanel x:Name="SelectedTagPanel"/>
                <Grid>
                    <TextBox x:Name="TagInput" Style="{StaticResource UnderlineBox}" MaxLength="21"
                             TextChanged="TagInput_TextChanged" KeyDown="TagInput_KeyDown" GotKeyboardFocus="TagInput_GotFocus"
                             AutomationProperties.AutomationId="TagInput" AutomationProperties.Name="태그 입력"/>
                    <TextBlock x:Name="TagHint" Text="태그를 검색하거나 새로 입력하고 Enter" FontSize="15" IsHitTestVisible="False"
                               Foreground="{DynamicResource SubTextBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <!-- 추천 목록: 입력한 글자가 들어간 태그 (많이 쓰인 순) -->
                <Popup x:Name="TagSuggestPopup" PlacementTarget="{Binding ElementName=TagInput}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, ElementName=TagInput}">
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="TagSuggestList"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </StackPanel>
            <TextBlock Grid.Row="4" Grid.Column="2" Text="최대 3개" Style="{StaticResource SubText}" Margin="16,30,0,0"/>
            <TextBlock x:Name="ErrorLabel" Grid.Row="5" Grid.Column="1" Style="{StaticResource ErrorText}" Margin="0,12,0,0"
                       Visibility="Collapsed"/>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Style="{StaticResource LinkButton}" Margin="0,0,24,0" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Style="{StaticResource GoldButton}" Padding="44,12" Click="Save_Click"
                    AutomationProperties.AutomationId="SavePlaylist"/>
        </StackPanel>
    </Grid>
</UserControl>
