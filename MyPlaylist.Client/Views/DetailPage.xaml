<UserControl x:Class="MyPlaylist.Client.Views.DetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:MyPlaylist.Client.Services"
             xmlns:views="clr-namespace:MyPlaylist.Client.Views">
    <Grid Margin="56,28,56,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>
        <!-- 왼쪽: 플레이리스트 정보 -->
        <Grid Margin="0,0,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 16:9 칸. 이 플레이리스트를 재생 중이면 이 자리에 영상이 겹쳐 표시된다. -->
            <Border x:Name="HeroFrame" Background="{DynamicResource PlaceholderBrush}" SizeChanged="HeroFrame_SizeChanged">
                <Image x:Name="HeroImage" Stretch="Uniform" Opacity="0.9"/>
            </Border>
            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock x:Name="TitleLabel" Style="{StaticResource TitleText}" FontSize="32"
                           AutomationProperties.AutomationId="DetailTitle"/>
                <TextBlock x:Name="DescriptionLabel" Style="{StaticResource SubText}" FontSize="15" Margin="0,6,0,0"
                           TextWrapping="Wrap" MaxHeight="46"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <views:Avatar x:Name="OwnerAvatar" Size="26"/>
                    <TextBlock x:Name="OwnerLabel" Style="{StaticResource BodyText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl x:Name="DetailTags" Margin="0,10,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TagChip}">
                                <TextBlock Text="{Binding}" Style="{StaticResource TagChipText}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="PlayAllButton" Style="{StaticResource GoldButton}" Padding="16,8" Margin="0,0,28,0"
                            Click="PlayAll_Click" Visibility="Collapsed" AutomationProperties.AutomationId="PlayAll">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="전체 재생" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LikeButton" Style="{StaticResource LinkButton}" Click="Like_Click"
                            AutomationProperties.AutomationId="LikeButton" AutomationProperties.Name="좋아요">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="HeartIcon" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="LikeLabel" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="LikeCount"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="InfoLabel" Style="{StaticResource SubText}" FontSize="16" Margin="28,0,0,0"
                               VerticalAlignment="Center" AutomationProperties.AutomationId="DetailInfo"/>
                </StackPanel>
                <TextBlock x:Name="LoginHint" Text="로그인하면 좋아요를 누를 수 있어요" Style="{StaticResource SubText}"
                           Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
        <Border Grid.Column="1" Background="{DynamicResource LineBrush}"/>
        <!-- 오른쪽: 곡 목록 -->
        <Grid Grid.Column="2" Margin="32,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" Padding="0,0,0,14">
                <Grid>
                    <!-- 곡 목록 / 댓글 전환: 선택한 쪽은 진하게, 나머지는 흐리게 -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TracksTabButton" Style="{StaticResource LinkButton}" Click="TracksTab_Click"
                                AutomationProperties.AutomationId="TracksTab">
                            <TextBlock Text="곡 목록" FontSize="26" FontWeight="Light"/>
                        </Button>
                        <Button x:Name="CommentsTabButton" Style="{StaticResource LinkButton}" Click="CommentsTab_Click"
                                Margin="28,0,0,0" AutomationProperties.AutomationId="CommentsTab">
                            <TextBlock x:Name="CommentsTabLabel" Text="댓글" FontSize="26" FontWeight="Light"/>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="OwnerActions" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                        <Button Content="곡 추가" Style="{StaticResource LinkButton}" Click="AddTrack_Click" Margin="0,0,24,0"
                                AutomationProperties.AutomationId="AddTrack"/>
                        <Button Content="수정" Style="{StaticResource LinkButton}" Click="EditPlaylist_Click" Margin="0,0,24,0"
                                AutomationProperties.AutomationId="EditPlaylist"/>
                        <Button Content="삭제" Style="{StaticResource DangerLinkButton}" Click="DeletePlaylist_Click"
                                AutomationProperties.AutomationId="DeletePlaylist"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer x:Name="TrackScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="TrackArea" VerticalAlignment="Top">
                    <ItemsControl x:Name="TrackList" Focusable="False" AllowDrop="True"
                                  DragOver="TrackList_DragOver" DragLeave="TrackList_DragLeave" Drop="TrackList_Drop">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 행을 누르면 앱 안에서 재생한다. -->
                                <Button Style="{StaticResource AreaButton}" Click="PlayTrack_Click" ToolTip="재생">
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- 순서 변경 손잡이: 플레이리스트 주인에게만 표시 -->
                                        <Border Background="Transparent" Padding="0,10,14,10" Cursor="SizeNS" VerticalAlignment="Center"
                                                Visibility="{Binding OwnerActionsVisibility}" ToolTip="끌어서 순서 바꾸기"
                                                MouseLeftButtonDown="DragHandle_MouseDown">
                                            <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                        </Border>
                                        <TextBlock x:Name="OrderText" Grid.Column="1" Text="{Binding DisplayOrder}" Style="{StaticResource RankText}" FontSize="26"/>
                                        <TextBlock x:Name="NowIcon" Grid.Column="1" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                   Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        <Border x:Name="ThumbBox" Grid.Column="2" Width="96" Height="54" ClipToBounds="True"
                                                BorderThickness="1" BorderBrush="Transparent"
                                                Background="{DynamicResource PlaceholderBrush}">
                                            <Image services:Thumb.Url="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="3" Margin="18,0,12,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TrackTitle" Text="{Binding MusicTitle}" Style="{StaticResource RowTitleText}"/>
                                            <TextBlock Text="{Binding Artist}" Style="{StaticResource SubText}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="YouTube에서 보기" Style="{StaticResource LinkButton}" Click="OpenYouTube_Click"/>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding OwnerActionsVisibility}">
                                                <Button Content="수정" Style="{StaticResource LinkButton}" Margin="20,0,0,0"
                                                        Click="EditTrack_Click"/>
                                                <Button Content="삭제" Style="{StaticResource DangerLinkButton}" Margin="20,0,0,0"
                                                        Click="DeleteTrack_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding NowPlaying}" Value="True">
                                        <Setter TargetName="OrderText" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="NowIcon" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="TrackTitle" Property="Foreground" Value="{DynamicResource GoldBrush}"/>
                                        <Setter TargetName="ThumbBox" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 끌고 있는 곡이 놓일 자리 -->
                    <Border x:Name="DropLine" Height="2" VerticalAlignment="Top" Background="{DynamicResource GoldBrush}"
                            IsHitTestVisible="False" Visibility="Collapsed"/>
                    <TextBlock x:Name="EmptyLabel" Text="아직 곡이 없습니다." Style="{StaticResource SubText}" Margin="0,24,0,0"
                               Visibility="Collapsed"/>
                </Grid>
            </ScrollViewer>
            <!-- 댓글 -->
            <Grid x:Name="CommentPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="CommentScroll" VerticalScrollBarVisibility="Auto">
                    <Grid VerticalAlignment="Top">
                        <ItemsControl x:Name="CommentList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" Padding="0,14">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <views:Avatar UserName="{Binding UserName}" Size="22" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding UserName}" Style="{StaticResource BodyText}" FontSize="15"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource SubText}" FontSize="13"
                                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Content="삭제" Style="{StaticResource DangerLinkButton}" FontSize="13"
                                                        HorizontalAlignment="Right" Visibility="{Binding DeleteVisibility}"
                                                        Click="DeleteComment_Click"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Content}" Style="{StaticResource BodyText}" Margin="0,6,0,0"
                                                       TextWrapping="Wrap" TextTrimming="None"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="CommentEmptyLabel" Text="첫 댓글을 남겨 보세요." Style="{StaticResource SubText}"
                                   Margin="0,24,0,0" Visibility="Collapsed"/>
                    </Grid>
                </ScrollViewer>
                <!-- 입력: 로그인한 경우 -->
                <Grid x:Name="CommentInput" Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <TextBox x:Name="CommentBox" Style="{StaticResource UnderlineBox}" MaxLength="500"
                                 TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto"
                                 KeyDown="CommentBox_KeyDown" TextChanged="CommentBox_TextChanged"
                                 AutomationProperties.AutomationId="CommentBox"/>
                        <TextBlock x:Name="CommentHint" Text="댓글을 입력하세요 (500자 이내)" FontSize="15" IsHitTestVisible="False"
                                   Foreground="{DynamicResource SubTextBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <Button Grid.Column="1" Content="등록" Style="{StaticResource GoldButton}" Padding="20,8" Margin="16,0,0,0"
                            VerticalAlignment="Center" Click="AddComment_Click" AutomationProperties.AutomationId="AddComment"/>
                </Grid>
                <!-- 입력: 비로그인 -->
                <StackPanel x:Name="CommentLoginHint" Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock Text="로그인하면 댓글을 남길 수 있어요" Style="{StaticResource SubText}" VerticalAlignment="Center"/>
                    <Button Content="로그인" Style="{StaticResource LinkButton}" FontSize="14" Margin="16,0,0,0" Click="CommentLogin_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
