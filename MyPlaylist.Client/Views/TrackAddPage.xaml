<UserControl x:Class="MyPlaylist.Client.Views.TrackAddPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:MyPlaylist.Client.Services">
    <Grid Margin="56,18,56,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Content="‹  플레이리스트로 돌아가기" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="Back_Click"
                AutomationProperties.AutomationId="BackToPlaylist"/>
        <TextBlock x:Name="TitleLabel" Grid.Row="1" Style="{StaticResource TitleText}" Margin="0,8,0,16"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 왼쪽: YouTube 검색 -->
            <Grid Margin="0,0,32,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="KeywordBox" Style="{StaticResource UnderlineBox}" MaxLength="100" VerticalAlignment="Center"
                             KeyDown="KeywordBox_KeyDown" TextChanged="KeywordBox_TextChanged"
                             AutomationProperties.AutomationId="YouTubeKeyword"/>
                    <TextBlock x:Name="KeywordHint" Text="YouTube에서 음악 검색" FontSize="15" IsHitTestVisible="False"
                               Foreground="{DynamicResource SubTextBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="SearchButton" Grid.Column="1" Content="검색" Style="{StaticResource GoldButton}" Margin="20,0,0,0"
                            Click="Search_Click" AutomationProperties.AutomationId="YouTubeSearch"/>
                </Grid>
                <TextBlock x:Name="HintLabel" Grid.Row="1" Text="추가하기 전에 곡 제목과 가수를 고칠 수 있어요"
                           Style="{StaticResource SubText}" Margin="0,12,0,8"/>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ResultList" Focusable="False" VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="104" Height="59" ClipToBounds="True"
                                                Background="{DynamicResource PlaceholderBrush}">
                                            <Image services:Thumb.Url="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MusicTitle}" Style="{StaticResource BodyText}" FontSize="16"/>
                                            <TextBlock Text="{Binding Artist}" Style="{StaticResource SubText}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="추가" Style="{StaticResource LinkButton}"
                                                Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center"
                                                Click="AddResult_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <Border Grid.Column="1" Background="{DynamicResource LineBrush}"/>
            <!-- 오른쪽: 현재 곡 목록. 손잡이를 끌어 순서를 바꾼다. -->
            <Grid Grid.Column="2" Margin="32,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" Padding="0,0,0,12">
                    <TextBlock Text="현재 곡 목록" Style="{StaticResource HeadingText}"/>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid VerticalAlignment="Top">
                        <ItemsControl x:Name="TrackList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" Padding="0,14"
                                            Background="Transparent" AllowDrop="True" Drop="TrackRow_Drop"
                                            AutomationProperties.Name="{Binding MusicTitle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="Transparent" Cursor="SizeAll" Padding="4,2,18,2" MouseMove="Handle_MouseMove">
                                                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                           Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayOrder}" Style="{StaticResource SubText}"
                                                       FontSize="17" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding MusicTitle}" Style="{StaticResource BodyText}"
                                                       FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Button Grid.Column="3" Content="삭제" Style="{StaticResource DangerLinkButton}"
                                                    VerticalAlignment="Center" Click="DeleteTrack_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyLabel" Text="아직 곡이 없습니다." Style="{StaticResource SubText}" Margin="0,24,0,0"
                                   Visibility="Collapsed"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
