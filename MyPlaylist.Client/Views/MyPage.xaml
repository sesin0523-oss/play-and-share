<UserControl x:Class="MyPlaylist.Client.Views.MyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MyPlaylist.Client.Views">
    <Grid Margin="56,28,56,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock x:Name="UserNameLabel" Style="{StaticResource TitleText}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="회원정보 수정" Style="{StaticResource LinkButton}" Click="EditUser_Click"
                        AutomationProperties.AutomationId="EditUser"/>
                <Border Width="1" Height="24" Background="{DynamicResource SubTextBrush}" Margin="22,0"/>
                <Button Content="로그아웃" Style="{StaticResource LinkButton}" Click="Logout_Click"
                        AutomationProperties.AutomationId="Logout"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="StatsLabel" Grid.Row="1" Style="{StaticResource SubText}" FontSize="15" Margin="0,8,0,0"
                   AutomationProperties.AutomationId="MyStats"/>
        <Border Grid.Row="2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="MineTab" Content="내 플레이리스트" GroupName="MyPageTab" Style="{StaticResource TabRadio}"
                             Checked="Tab_Checked" AutomationProperties.AutomationId="TabMine"/>
                <RadioButton x:Name="LikedTab" Content="좋아요한 플레이리스트" GroupName="MyPageTab" Style="{StaticResource TabRadio}"
                             Checked="Tab_Checked" AutomationProperties.AutomationId="TabLiked"/>
                <RadioButton x:Name="RecentTab" Content="최근 본 플레이리스트" GroupName="MyPageTab" Style="{StaticResource TabRadio}"
                             Checked="Tab_Checked" AutomationProperties.AutomationId="TabRecent"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <views:PlaylistList x:Name="MyList" VerticalAlignment="Top"/>
        </ScrollViewer>
    </Grid>
</UserControl>
