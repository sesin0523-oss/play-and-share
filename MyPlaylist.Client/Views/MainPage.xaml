<UserControl x:Class="MyPlaylist.Client.Views.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MyPlaylist.Client.Views"
             xmlns:services="clr-namespace:MyPlaylist.Client.Services">
    <!-- 아래쪽 "취향을 더 넓혀보세요"까지 보도록 화면 전체를 스크롤한다. -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
    <Grid Margin="56,20,56,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- 오늘의 추천 / 순위: 스크롤 안에서는 높이를 정해 두어야 썸네일이 늘어나지 않는다. -->
            <RowDefinition Height="530"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="오늘은 어떤 음악이 끌리나요?" Style="{StaticResource TitleText}"/>
        <TextBlock x:Name="StatsLabel" Grid.Row="1" Style="{StaticResource SubText}" FontSize="15" Margin="0,6,0,0"
                   AutomationProperties.AutomationId="MainStats"/>
        <!-- 태그 필터: 콤보박스에서 하나를 고른다. (많이 쓰인 태그 순) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,8">
            <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                       Foreground="{DynamicResource SubTextBrush}"/>
            <TextBlock Text="태그" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="8,0,14,0"/>
            <ComboBox x:Name="TagFilterBox" Style="{StaticResource UnderlineCombo}" Width="200"
                      SelectionChanged="TagFilterBox_SelectionChanged"
                      AutomationProperties.AutomationId="TagFilter" AutomationProperties.Name="태그로 걸러 보기"/>
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 왼쪽: 오늘의 추천 (하루에 한 번 바뀜) -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="오늘의 추천" Style="{StaticResource HeadingText}" Margin="0,0,0,12"/>
                <Button x:Name="PickButton" Grid.Row="1" Style="{StaticResource AreaButton}" Click="Pick_Click"
                        Visibility="Hidden" AutomationProperties.AutomationId="TodayPick">
                    <Border BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" CornerRadius="6"
                            Background="{DynamicResource DialogBrush}" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- 썸네일: 남는 높이만큼 채우고 넘치는 부분은 자른다. -->
                            <Border Background="{DynamicResource PlaceholderBrush}" ClipToBounds="True" CornerRadius="6,6,0,0" MinHeight="80">
                                <Image x:Name="PickImage" Stretch="UniformToFill" VerticalAlignment="Center" Opacity="0.92"/>
                            </Border>
                            <Border Grid.Row="1" Padding="22,14,22,16">
                                <StackPanel>
                                    <TextBlock Text="T O D A Y ' S   P I C K" Foreground="{DynamicResource GoldBrush}" FontSize="12"/>
                                    <TextBlock x:Name="PickTitle" Style="{StaticResource HeadingText}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="PickDescription" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                                    <ItemsControl x:Name="PickTags" Margin="0,10,0,0" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TagChip}">
                                                    <TextBlock Text="{Binding}" Style="{StaticResource TagChipText}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}" Margin="0,12,0,0" Padding="0,12,0,0">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <views:Avatar x:Name="PickAvatar" Size="28"/>
                                                <TextBlock x:Name="PickOwner" Style="{StaticResource BodyText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="PickInfo" Style="{StaticResource SubText}" Margin="18,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{DynamicResource SubTextBrush}"
                                                    CornerRadius="4" Padding="14,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="플레이리스트 열기" Style="{StaticResource BodyText}" FontSize="14"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Button>
                <TextBlock x:Name="PickEmptyLabel" Grid.Row="1" Text="아직 추천할 플레이리스트가 없습니다."
                           Style="{StaticResource SubText}" Visibility="Collapsed"/>
            </Grid>
            <!-- 오른쪽: 순위 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="RankHeading" Text="지금 인기 있는 플레이리스트" Style="{StaticResource HeadingText}" Margin="0,0,0,8"/>
                <Grid Grid.Row="1" Margin="-10,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LikesTab" Content="좋아요순" GroupName="MainSort" Style="{StaticResource SmallTabRadio}"
                                     Checked="Tab_Checked" AutomationProperties.AutomationId="TabLikes"/>
                        <RadioButton x:Name="ViewsTab" Content="클릭순" GroupName="MainSort" Style="{StaticResource SmallTabRadio}"
                                     Checked="Tab_Checked" AutomationProperties.AutomationId="TabViews"/>
                        <RadioButton x:Name="LatestTab" Content="최신순" GroupName="MainSort" Style="{StaticResource SmallTabRadio}"
                                     Checked="Tab_Checked" AutomationProperties.AutomationId="TabLatest"/>
                    </StackPanel>
                    <!-- 집계 기간: 좋아요순 / 클릭순에서만 표시 -->
                    <ComboBox x:Name="PeriodBox" Style="{StaticResource UnderlineCombo}" Width="120" HorizontalAlignment="Right"
                              FontSize="14" SelectionChanged="PeriodBox_SelectionChanged"
                              AutomationProperties.AutomationId="PeriodBox" AutomationProperties.Name="집계 기간">
                        <ComboBoxItem Content="전체 기간" Tag="0"/>
                        <ComboBoxItem Content="최근 7일" Tag="7"/>
                        <ComboBoxItem Content="최근 30일" Tag="30"/>
                    </ComboBox>
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <views:PlaylistList x:Name="RankList" VerticalAlignment="Top"/>
                </ScrollViewer>
                <Button x:Name="MoreButton" Grid.Row="3" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                        Margin="0,10,0,0" Click="More_Click" AutomationProperties.AutomationId="MoreRanking">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="MoreLabel" Text="인기 플레이리스트 더 보기" Foreground="{DynamicResource GoldBrush}" FontSize="15"/>
                        <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="10,1,0,0"
                                   Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
        <!-- 취향을 더 넓혀보세요: 아직 열어보지 않은 플레이리스트, 처음 만나는 태그 우선 -->
        <Grid Grid.Row="4" Margin="0,40,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="취향을 더 넓혀보세요" Style="{StaticResource HeadingText}"/>
                <TextBlock x:Name="DiscoverHint" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <RadioButton x:Name="DiscoverLatest" Content="최신순" GroupName="DiscoverSort" Style="{StaticResource ChipToggle}"
                             Margin="0,0,8,0" Checked="DiscoverSort_Checked" AutomationProperties.AutomationId="DiscoverLatest"/>
                <RadioButton x:Name="DiscoverLikes" Content="좋아요순" GroupName="DiscoverSort" Style="{StaticResource ChipToggle}"
                             Margin="0" Checked="DiscoverSort_Checked" AutomationProperties.AutomationId="DiscoverLikes"/>
            </StackPanel>
            <ItemsControl x:Name="DiscoverList" Grid.Row="1" Margin="0,16,-16,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource AreaButton}" Margin="0,0,16,0" Click="Discover_Click"
                                AutomationProperties.Name="{Binding Playlist.PlaylistTitle}">
                            <Border BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" CornerRadius="6"
                                    Background="{DynamicResource DialogBrush}" ClipToBounds="True">
                                <StackPanel>
                                    <Border Height="150" Background="{DynamicResource PlaceholderBrush}" CornerRadius="6,6,0,0" ClipToBounds="True">
                                        <Image services:Thumb.Url="{Binding Playlist.ThumbnailUrl}" Stretch="UniformToFill"
                                               VerticalAlignment="Center" Opacity="0.92"/>
                                    </Border>
                                    <Grid Margin="16,12,16,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Playlist.PlaylistTitle}" Style="{StaticResource RowTitleText}"/>
                                        <Grid Grid.Row="1" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 태그: 처음 만나는 태그는 골드 테두리 + NEW -->
                                            <ItemsControl ItemsSource="{Binding TagViews}" Focusable="False" ClipToBounds="True">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="Chip" Style="{StaticResource TagChip}">
                                                            <TextBlock x:Name="ChipText" Text="{Binding Text}" Style="{StaticResource TagChipText}"/>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                                                                <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource GoldBrush}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                <views:Avatar UserName="{Binding Playlist.UserName}" Size="22"/>
                                                <TextBlock Text="{Binding Playlist.UserName}" Style="{StaticResource SubText}"
                                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="DiscoverEmpty" Grid.Row="1" Style="{StaticResource SubText}" Margin="0,16,0,0" Visibility="Collapsed"/>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
