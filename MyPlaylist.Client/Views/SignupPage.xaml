<UserControl x:Class="MyPlaylist.Client.Views.SignupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,24,56,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Source="/Assets/auth.jpg" Stretch="UniformToFill"/>
        <Grid Grid.Column="1" Margin="64,0,0,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.ColumnSpan="3" Text="회원가입" Style="{StaticResource TitleText}" Margin="0,0,0,30"/>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="아이디" Style="{StaticResource BodyText}" FontSize="17"/>
                <TextBlock Text="2~50자" Style="{StaticResource SubText}" FontSize="13"/>
            </StackPanel>
            <TextBox x:Name="UserNameBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource UnderlineBox}" MaxLength="50"
                     TextChanged="UserNameBox_TextChanged" VerticalAlignment="Center"
                     AutomationProperties.AutomationId="SignupUserName"/>
            <Button Grid.Row="1" Grid.Column="2" Content="중복 확인" Style="{StaticResource LinkButton}" Margin="16,0,0,0"
                    Click="CheckName_Click" AutomationProperties.AutomationId="CheckName"/>
            <TextBlock x:Name="NameResultLabel" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" FontSize="14"
                       Margin="2,6,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="NameResult"/>
            <StackPanel Grid.Row="3" VerticalAlignment="Center" Margin="0,18,0,0">
                <TextBlock Text="비밀번호" Style="{StaticResource BodyText}" FontSize="17"/>
                <TextBlock Text="8~100자" Style="{StaticResource SubText}" FontSize="13"/>
            </StackPanel>
            <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource UnderlinePassword}"
                         Margin="0,18,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="SignupPassword"/>
            <TextBlock Grid.Row="4" Text="비밀번호 확인" Style="{StaticResource BodyText}" FontSize="17" VerticalAlignment="Center" Margin="0,22,0,0"/>
            <PasswordBox x:Name="PasswordConfirmBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource UnderlinePassword}"
                         Margin="0,22,0,0" AutomationProperties.AutomationId="SignupPasswordConfirm"/>
            <TextBlock x:Name="ErrorLabel" Grid.Row="5" Grid.ColumnSpan="3" Style="{StaticResource ErrorText}" Margin="0,16,0,0"
                       Visibility="Collapsed" AutomationProperties.AutomationId="SignupError"/>
            <Button Grid.Row="6" Grid.ColumnSpan="3" Content="가입하기" Style="{StaticResource GoldButton}" IsDefault="True"
                    Padding="0,14" Margin="0,26,0,0" Click="Signup_Click" AutomationProperties.AutomationId="SignupSubmit"/>
            <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <TextBlock Text="이미 계정이 있나요?" Style="{StaticResource SubText}" FontSize="15" VerticalAlignment="Center"/>
                <Button Content="로그인" Style="{StaticResource LinkButton}" Margin="16,0,0,0" Click="Login_Click"
                        AutomationProperties.AutomationId="GoLogin"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
