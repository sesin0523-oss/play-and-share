<UserControl x:Class="MyPlaylist.Client.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="560" MinWidth="420">
        <TextBlock x:Name="TitleLabel" Style="{StaticResource HeadingText}"/>
        <TextBlock x:Name="MessageLabel" Style="{StaticResource BodyText}" TextWrapping="Wrap" TextTrimming="None"
                   Margin="0,14,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
            <Button x:Name="CancelButton" Content="취소" Style="{StaticResource LinkButton}" Margin="0,0,24,0"
                    Click="Cancel_Click" AutomationProperties.AutomationId="DialogCancel"/>
            <Button x:Name="ConfirmButton" Style="{StaticResource GoldButton}" Click="Confirm_Click"
                    AutomationProperties.AutomationId="DialogConfirm"/>
        </StackPanel>
    </StackPanel>
</UserControl>
