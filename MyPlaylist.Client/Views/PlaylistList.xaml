<UserControl x:Class="MyPlaylist.Client.Views.PlaylistList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:MyPlaylist.Client.Services"
             xmlns:views="clr-namespace:MyPlaylist.Client.Views">
    <Grid>
        <ItemsControl x:Name="Rows" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource AreaButton}" Click="Row_Click"
                            AutomationProperties.Name="{Binding PlaylistTitle}">
                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" Padding="0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Rank}" Style="{StaticResource RankText}" Width="62"
                                           Padding="16,0,0,0" Visibility="{Binding RankVisibility}"/>
                                <Border Grid.Column="1" Width="112" Height="63" Background="{DynamicResource PlaceholderBrush}"
                                        ClipToBounds="True">
                                    <Image services:Thumb.Url="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="2" Margin="24,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PlaylistTitle}" Style="{StaticResource RowTitleText}"/>
                                    <!-- 만든 사람(프로필 동그라미 + 아이디)과 태그 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding OwnerVisibility}" Margin="0,0,10,0">
                                            <views:Avatar UserName="{Binding UserName}" Size="20"/>
                                            <TextBlock Text="{Binding UserName}" Style="{StaticResource SubText}" Margin="6,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Tags}" Visibility="{Binding TagsVisibility}" Focusable="False"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource TagChip}">
                                                        <TextBlock Text="{Binding}" Style="{StaticResource TagChipText}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Info}" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding PublicText}" Style="{StaticResource SubText}" FontSize="15"
                                               Visibility="{Binding PublicVisibility}"/>
                                    <TextBlock Text="&#xEB52;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{DynamicResource GoldBrush}" Visibility="{Binding HeartVisibility}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="EmptyLabel" Style="{StaticResource SubText}" Margin="0,24,0,0" Visibility="Collapsed"/>
    </Grid>
</UserControl>
