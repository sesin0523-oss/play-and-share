<UserControl x:Class="MyPlaylist.Client.Views.TrackEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="520">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleLabel" Grid.ColumnSpan="2" Style="{StaticResource HeadingText}" Margin="0,0,0,20"/>
        <TextBlock Grid.Row="1" Text="곡 제목" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
        <TextBox x:Name="MusicTitleBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource UnderlineBox}" MaxLength="200"
                 Margin="0,6" AutomationProperties.AutomationId="TrackTitleBox"/>
        <TextBlock Grid.Row="2" Text="가수" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
        <TextBox x:Name="ArtistBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource UnderlineBox}" MaxLength="200"
                 Margin="0,6" AutomationProperties.AutomationId="TrackArtistBox"/>
        <TextBlock Grid.Row="3" Text="YouTube 영상 ID" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
        <TextBox x:Name="VideoIdBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource UnderlineBox}" IsReadOnly="True"
                 Margin="0,6"/>
        <TextBlock x:Name="ErrorLabel" Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource ErrorText}" Margin="0,10,0,0"
                   Visibility="Collapsed"/>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="취소" Style="{StaticResource LinkButton}" Margin="0,0,24,0" Click="Cancel_Click"
                    AutomationProperties.AutomationId="DialogCancel"/>
            <Button x:Name="SaveButton" Style="{StaticResource GoldButton}" Click="Save_Click"
                    AutomationProperties.AutomationId="DialogConfirm"/>
        </StackPanel>
    </Grid>
</UserControl>
