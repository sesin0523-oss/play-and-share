{
  "info": {
    "name": "My Playlist CRUD 테스트",
    "description": "회원, 플레이리스트, 곡의 CRUD를 순서대로 테스트합니다. 앞 요청의 결과를 뒤 요청이 사용하므로 Collection Runner로 전체를 순서대로 실행하세요. 실행할 때마다 새 회원을 만들고 마지막에 탈퇴합니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5080" },
    { "key": "password", "value": "password123" }
  ],
  "item": [
    {
      "name": "0. 준비",
      "item": [
        {
          "name": "로그아웃 (이전 실행의 쿠키 정리)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "var runId = 'pm' + new Date().getTime();",
              "pm.collectionVariables.set('runId', runId);",
              "pm.collectionVariables.set('userName', runId);",
              "pm.collectionVariables.set('otherName', runId + '_other');"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('204 No Content', function () { pm.response.to.have.status(204); });"
            ] } }
          ],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/users/logout" }
        },
        {
          "name": "[등록 실패] 비로그인으로 플레이리스트 생성 - 401",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{ \"playlistTitle\": \"비로그인\", \"isPublic\": true }", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/playlists"
          }
        }
      ]
    },
    {
      "name": "1. 회원 CRUD",
      "item": [
        {
          "name": "[등록] 회원가입 - 201",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
              "var body = pm.response.json();",
              "pm.test('아이디가 그대로 반환된다', function () { pm.expect(body.userName).to.eql(pm.collectionVariables.get('userName')); });",
              "pm.test('비밀번호는 응답에 없다', function () { pm.expect(body.password === undefined && body.userPw === undefined).to.eql(true); });",
              "pm.collectionVariables.set('userId', body.userId);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{ \"userName\": \"{{userName}}\", \"password\": \"{{password}}\" }", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users/signup"
          }
        },
        {
          "name": "[등록 실패] 같은 아이디로 가입 - 409",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('409 Conflict', function () { pm.response.to.have.status(409); });"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{ \"userName\": \"{{userName}}\", \"password\": \"{{password}}\" }", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users/signup"
          }
        },
