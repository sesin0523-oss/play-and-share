              "pm.test('이번 실행에서 만든 1건만 검색된다', function () { pm.expect(pm.response.json().totalCount).to.eql(1); });"
            ] } }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/playlists?keyword={{runId}}&sort=latest&page=1&size=20" }
        },
