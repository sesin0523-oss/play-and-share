          "name": "[조회] 상세 조회 - 200",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "var playlist = pm.response.json().playlist;",
              "pm.test('만든 플레이리스트가 조회된다', function () { pm.expect(String(playlist.playlistId)).to.eql(String(pm.collectionVariables.get('playlistId'))); });",
              "pm.test('조회수가 1이 된다', function () { pm.expect(playlist.viewCount).to.eql(1); });"
            ] } }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/playlists/{{playlistId}}" }
        },
