            "url": "{{baseUrl}}/api/users/signup"
          }
        },
        {
          "name": "로그인 실패 (틀린 비밀번호) - 401",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{ \"userName\": \"{{userName}}\", \"password\": \"wrongpassword\" }", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users/login"
          }
        },
        {
          "name": "로그인 - 200 (쿠키 발급)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('가입한 회원으로 로그인된다', function () { pm.expect(String(pm.response.json().userId)).to.eql(String(pm.collectionVariables.get('userId'))); });"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{ \"userName\": \"{{userName}}\", \"password\": \"{{password}}\" }", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users/login"
          }
        },
        {
          "name": "[조회] 내 회원정보 - 200",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('내 아이디가 조회된다', function () { pm.expect(pm.response.json().userName).to.eql(pm.collectionVariables.get('userName')); });"
            ] } }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}" }
        },
        {
          "name": "[수정] 아이디 변경 - 204",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('204 No Content', function () { pm.response.to.have.status(204); });",
              "pm.collectionVariables.set('userName', pm.collectionVariables.get('userName') + '_new');"
            ] } }
          ],
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{ \"userName\": \"{{userName}}_new\" }", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "[조회] 수정 결과 확인 - 200",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('바뀐 아이디가 조회된다', function () { pm.expect(pm.response.json().userName).to.eql(pm.collectionVariables.get('userName')); });"
            ] } }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}" }
        }
      ]
    },
    {
      "name": "2. 플레이리스트 CRUD",
      "item": [
        {
